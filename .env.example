# Public frontend flags. NOSTR_CITY_PUBLIC_* variables are bundled into the browser app.
# Keep false for local/self-hosted full-capability usage.
# Docker Compose also reads .env for NOSTR_CITY_PUBLIC_DEMO_MODE build arg interpolation.
# Keep false for local Docker unless intentionally testing public-demo behavior.
NOSTR_CITY_PUBLIC_DEMO_MODE=false

# Optional public URL overrides used by landing/docs links when hosted separately.
VITE_APP_URL=
VITE_DOCS_URL=

# Local BFF defaults. Do not put production secrets in this file.
HOST=127.0.0.1
PORT=3000
BFF_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
FASTIFY_TRUST_PROXY=loopback
